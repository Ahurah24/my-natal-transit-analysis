# Local credentials only. Never commit .env.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
ARM_LIVE_TRADING=false

ARZINJA_BASE_URL=https://api-v2.arzinja.app/api
ARZINJA_API_KEY=
ARZINJA_API_SECRET=
ARZINJA_RECV_WINDOW_MS=5000

# Safety defaults
REQUIRE_ZERO_FEE=true
MAX_SPREAD_PERCENT=0.8
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2
MAX_POSITION_PCT=10
MAX_OPEN_POSITIONS=2
MAX_TRADES_PER_DAY=8
